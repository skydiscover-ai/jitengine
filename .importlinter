; The layering contracts of the engines (`lint-imports` from the repository root, with the engines
; and the launcher installed). Each engine is its own package, and none imports another; the
; launcher talks to an engine over HTTP only. The engines share jitengine_runtime, which imports none of
; them. A model whose builds share one engine (Flint: jitengine_flint) has a package per build that
; carries the build's command and imports only that engine.
[importlinter]
root_packages =
    jitengine_qwen
    jitengine_qwen3_6_35b_a3b
    jitengine_qwen3_8_flash_next
    jitengine_qwen3_6_35b_a3b_m2
    jitengine_qwen3_6_35b_a3b_m4pro
    jitengine_qwen3_8_flash_next_m4pro
    jitengine_qwen3_8_flash_next_m2
